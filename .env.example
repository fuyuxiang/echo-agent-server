# Echo Agent Server — environment template
# 复制为 .env 后按需调整。生产请确保所有 *KEY*、*SECRET* 都是随机高熵值。

# 服务监听
ECHO_PORT=8787
ECHO_HOST=0.0.0.0

# 存储
ECHO_DB_PATH=./data/echo.db
ECHO_STORAGE_DIR=./data/storage
ECHO_MODEL_DIR=./data/models

# JWT 与加密主密钥 —— 必填,缺失时启动即失败
ECHO_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ECHO_MASTER_KEY=change-me-to-another-random-string

# 初始管理员(首次启动时创建)
ECHO_ADMIN_USER=admin
ECHO_ADMIN_PASSWORD=change-me-strong-admin-password
# HTTPS 生产环境默认 true；仅纯 HTTP 内网入口显式设为 false。
# ECHO_COOKIE_SECURE=true

# 对话模型（数据库中的后台配置优先；这里可让新部署立即具备生成式问答）
ECHO_CHAT_PROVIDER=openai-compatible
# ECHO_CHAT_MODEL=gpt-4o-mini
# ECHO_CHAT_BASE_URL=https://api.openai.com/v1
# ECHO_CHAT_KEY=sk-xxx
ECHO_REQUIRE_CHAT=true

# 嵌入/精排远端模型(OpenAI 兼容)—— 不配则用 hash/lexical 占位实现
ECHO_EMBED_MODEL=bge-m3
ECHO_EMBED_DIM=1024
ECHO_RERANK_MODEL=bge-reranker-v2-m3
# ECHO_EMBED_URL=https://your-embed-host/v1/embeddings
# ECHO_EMBED_KEY=sk-xxx
# ECHO_RERANK_URL=https://your-rerank-host/v1/rerank
# ECHO_RERANK_KEY=sk-xxx

# OCR / VLM（不配时扫描 PDF 会明确失败，图片上传会同步拒绝）
# ECHO_OCR_URL=https://your-ocr-host/extract
# ECHO_OCR_KEY=sk-xxx
# ECHO_VLM_URL=https://your-vlm-host/caption
# ECHO_VLM_KEY=sk-xxx
# ECHO_VLM_MODEL=your-vision-model

# 音视频转写：填写完整的 OpenAI-compatible /audio/transcriptions 地址。
# 视频额外依赖 ffmpeg；Docker 镜像已内置。
# ECHO_TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
# ECHO_TRANSCRIBE_KEY=sk-xxx
ECHO_TRANSCRIBE_MODEL=whisper-1
ECHO_TRANSCRIBE_TIMEOUT_MS=600000

# 可按产品承诺决定哪些可选能力必须通过生产就绪检查。
ECHO_REQUIRE_OCR=false
ECHO_REQUIRE_VLM=false
ECHO_REQUIRE_TRANSCRIPTION=false

# 上传与过时阈值
ECHO_MAX_UPLOAD_BYTES=209715200
ECHO_STALE_DAYS=90

# SQLite 在线备份；迁移前始终备份已有数据库。0 表示关闭周期备份。
ECHO_BACKUP_DIR=./backups
ECHO_BACKUP_INTERVAL_HOURS=24
ECHO_BACKUP_RETENTION=14

# CORS 白名单,逗号分隔;留空则拒绝跨域(同源访问)
# ECHO_CORS_ORIGINS=https://admin.example.com

# 限流阈值(0 表示禁用)
ECHO_RATE_LIMIT_RETRIEVE=60
ECHO_RATE_LIMIT_LLM=20
ECHO_RATE_LIMIT_LOGIN=5

# 日志级别
ECHO_LOG_LEVEL=info
