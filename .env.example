# Echo Agent Server — environment template
# 复制为 .env 后按需调整。生产请确保所有 *KEY*、*SECRET* 都是随机高熵值。

# 服务监听
ECHO_PORT=8787
ECHO_HOST=0.0.0.0

# 存储
ECHO_DB_PATH=./data/echo.db
ECHO_STORAGE_DIR=./data/storage
ECHO_MODEL_DIR=./data/models

# JWT 与加密主密钥 —— 必填,缺失时启动即失败
ECHO_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ECHO_MASTER_KEY=change-me-to-another-random-string

# 初始管理员(首次启动时创建)
ECHO_ADMIN_USER=admin
ECHO_ADMIN_PASSWORD=change-me-strong-admin-password

# 嵌入/精排远端模型(OpenAI 兼容)—— 不配则用 hash/lexical 占位实现
ECHO_EMBED_MODEL=bge-m3
ECHO_EMBED_DIM=1024
ECHO_RERANK_MODEL=bge-reranker-v2-m3
# ECHO_EMBED_URL=https://your-embed-host/v1/embeddings
# ECHO_EMBED_KEY=sk-xxx
# ECHO_RERANK_URL=https://your-rerank-host/v1/rerank
# ECHO_RERANK_KEY=sk-xxx

# OCR / VLM(可选;不配时扫描件与图片落到占位实现,后置校验会标 failed)
# ECHO_OCR_URL=https://your-ocr-host/extract
# ECHO_VLM_URL=https://your-vlm-host/caption
# ECHO_VLM_KEY=sk-xxx

# 上传与过时阈值
ECHO_MAX_UPLOAD_BYTES=209715200
ECHO_STALE_DAYS=90

# CORS 白名单,逗号分隔;留空则拒绝跨域(同源访问)
# ECHO_CORS_ORIGINS=https://admin.example.com

# 限流阈值(0 表示禁用)
ECHO_RATE_LIMIT_RETRIEVE=60
ECHO_RATE_LIMIT_LLM=20
ECHO_RATE_LIMIT_LOGIN=5

# 日志级别
ECHO_LOG_LEVEL=info
