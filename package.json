{
  "name": "echo-agent-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build:assets",
    "build:assets": "node -e \"const fs=require('fs');const p=require('path');const src='src/db/migrations';const dst='dist/db/migrations';fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(p.join(src,f),p.join(dst,f));}\"",
    "start": "node dist/server.js",
    "eval": "tsx eval/run.ts",
    "eval:ci": "bash eval/ci.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
