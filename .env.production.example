# Used by: docker compose --env-file .env.production up -d --build
ECHO_PUBLIC_DOMAIN=memory.example.com
# Fastify 前只有一层可信 Caddy/Nginx。
ECHO_TRUST_PROXY_HOPS=1

# Non-secret server configuration. Secrets are mounted from deploy/secrets/.
ECHO_ADMIN_USER=admin
ECHO_CHAT_PROVIDER=openai-compatible
ECHO_CHAT_MODEL=your-production-chat-model
ECHO_CHAT_BASE_URL=https://model-gateway.example.com/v1
ECHO_EMBED_MODEL=bge-m3
ECHO_EMBED_DIM=1024
ECHO_RERANK_MODEL=bge-reranker-v2-m3
ECHO_MAX_UPLOAD_BYTES=209715200
ECHO_STALE_DAYS=90
ECHO_RATE_LIMIT_RETRIEVE=60
ECHO_RATE_LIMIT_LLM=20
ECHO_RATE_LIMIT_LOGIN=5
ECHO_LOG_LEVEL=info
ECHO_BACKUP_INTERVAL_HOURS=24
ECHO_BACKUP_RETENTION=30
ECHO_ANTIVIRUS_HOST=clamav
ECHO_ANTIVIRUS_PORT=3310
ECHO_ANTIVIRUS_REQUIRED=true
ECHO_ANTIVIRUS_TIMEOUT_MS=30000
ECHO_REQUIRE_CHAT=true
ECHO_REQUIRE_OCR=true
ECHO_REQUIRE_VLM=true
ECHO_REQUIRE_TRANSCRIPTION=true

# Production model/media services. Replace every example.com endpoint before rollout.
ECHO_EMBED_URL=https://model-gateway.example.com/v1/embeddings
# ECHO_EMBED_KEY_FILE=/run/secrets/echo_embed_key
ECHO_RERANK_URL=https://model-gateway.example.com/v1/rerank
# ECHO_RERANK_KEY_FILE=/run/secrets/echo_rerank_key
ECHO_OCR_URL=https://ocr.example.com/extract
ECHO_VLM_URL=https://vision.example.com/caption
ECHO_VLM_MODEL=your-production-vision-model
# ECHO_VLM_KEY_FILE=/run/secrets/echo_vlm_key
ECHO_TRANSCRIBE_URL=https://model-gateway.example.com/v1/audio/transcriptions
ECHO_TRANSCRIBE_MODEL=whisper-1
ECHO_TRANSCRIBE_TIMEOUT_MS=600000
