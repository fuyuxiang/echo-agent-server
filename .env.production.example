# Used by: docker compose --env-file .env.production up -d --build
ECHO_PUBLIC_DOMAIN=memory.example.com

# Non-secret server configuration. Secrets are mounted from deploy/secrets/.
ECHO_ADMIN_USER=admin
ECHO_EMBED_MODEL=bge-m3
ECHO_EMBED_DIM=1024
ECHO_RERANK_MODEL=bge-reranker-v2-m3
ECHO_MAX_UPLOAD_BYTES=209715200
ECHO_STALE_DAYS=90
ECHO_RATE_LIMIT_RETRIEVE=60
ECHO_RATE_LIMIT_LLM=20
ECHO_RATE_LIMIT_LOGIN=5
ECHO_LOG_LEVEL=info

# Production semantic services (strongly recommended before employee rollout):
# ECHO_EMBED_URL=https://model-gateway.example.com/v1/embeddings
# ECHO_EMBED_KEY_FILE=/run/secrets/echo_embed_key
# ECHO_RERANK_URL=https://model-gateway.example.com/v1/rerank
# ECHO_RERANK_KEY_FILE=/run/secrets/echo_rerank_key
# ECHO_OCR_URL=https://ocr.example.com/extract
# ECHO_VLM_URL=https://model-gateway.example.com/v1/chat/completions
# ECHO_VLM_KEY_FILE=/run/secrets/echo_vlm_key
